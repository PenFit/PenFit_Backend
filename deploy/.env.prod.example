# OCI 서버의 ~/penfit/.env 로 복사해서 실제 값으로 채운다. 이 파일은 절대 커밋하지 않는다.

# 무료 도메인 (DuckDNS 예: penfit.duckdns.org)
PENFIT_DOMAIN=penfit.duckdns.org

# 배포할 이미지. GitHub Actions가 배포할 때 커밋 SHA 태그로 덮어쓴다.
PENFIT_IMAGE=ghcr.io/penfit/penfit_backend:latest

# 데이터베이스 (반드시 강한 비밀번호로 교체)
POSTGRES_DB=penfit
POSTGRES_USER=penfit
POSTGRES_PASSWORD=change-me

# AI 서버
AI_BASE_URL=http://ai-server:8000
AI_INTERNAL_API_KEY=change-me
