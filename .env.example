# docker-compose 로컬 DB
POSTGRES_DB=penfit
POSTGRES_USER=penfit
POSTGRES_PASSWORD=penfit
POSTGRES_PORT=5432

# 애플리케이션
DB_URL=jdbc:postgresql://localhost:5432/penfit
DB_USERNAME=penfit
DB_PASSWORD=penfit

# AI 서버 (로컬은 http://localhost:8000, 컴포즈는 http://ai-server:8000)
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=local-dev-key
